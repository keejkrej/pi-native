			"@pi-ts/ffi": [
				"../../../packages/ffi/src/index.ts"
			],
			"@pi-ts/gui": [
				"../../../packages/gui/src/index.ts"
			],
			"@pi-ts/gui/native": [
				"../../../packages/gui/src/native.ts"
			]
		}
	},
	"include": [
		"./extensions/**/*",
		"../../*/src/**/*.d.ts",
		"../test/suite/regressions/8261-subagent-project-trust.test.ts",
		"../test/subagent-extension.test.ts"
	],
	"exclude": [
		"**/node_modules/**",
		"./extensions/gondolin/**"
	]
