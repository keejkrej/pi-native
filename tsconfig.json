{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@pi-ts/telemetry": ["./packages/telemetry/src/index.ts"],
			"@pi-ts/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@pi-ts/telemetry/render": ["./packages/telemetry/src/render.ts"],
			"@pi-ts/schema": ["./packages/schema/src/index.ts"],
			"@pi-ts/schema/formats": ["./packages/schema/src/formats/index.ts"],
			"@pi-ts/mcp": ["./packages/mcp/src/index.ts"],
			"@pi-ts/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@pi-ts/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@pi-ts/ai": ["./packages/ai/src/index.ts"],
			"@pi-ts/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@pi-ts/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@pi-ts/agent-core": ["./packages/agent/src/index.ts"],
			"@pi-ts/agent-core/*": ["./packages/agent/src/*.ts"],
			"@pi-ts/tui": ["./packages/tui/src/index.ts"],
			"@pi-ts/tui/*": ["./packages/tui/src/*.ts"],
			"@pi-ts/ffi": ["./packages/ffi/src/index.ts"],
			"@pi-ts/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@pi-ts/coding-agent/*": ["./packages/coding-agent/src/*.ts"],
			"@pi-ts/gui": ["./packages/gui/src/index.ts"],
			"@pi-ts/gui/native": ["./packages/gui/src/native.ts"],
			"chalk": ["./vendor/chalk/index.ts"],
			"typebox": ["./vendor/typebox/index.ts"],
			"typebox/compile": ["./vendor/typebox/compile.ts"],
			"typebox/error": ["./vendor/typebox/error.ts"],
			"proper-lockfile": ["./vendor/proper-lockfile/index.ts"],
			"cross-spawn": ["./vendor/cross-spawn/index.ts"],
			"hosted-git-info": ["./vendor/hosted-git-info/index.ts"],
			"ignore": ["./vendor/ignore/index.ts"],
			"yaml": ["./vendor/yaml/index.ts"],
			"highlight.js": ["./vendor/highlight-js/index.ts"],
			"highlight.js/lib/core.js": ["./vendor/highlight-js/core.ts"],
			"highlight.js/lib/index.js": ["./vendor/highlight-js/index.ts"],
			"highlight.js/lib/languages/*.js": ["./vendor/highlight-js/languages/*.ts"],
			"marked": ["./vendor/marked/index.ts"],
			"marked-cjk-friendly": ["./vendor/marked-cjk-friendly/index.ts"],
			"get-east-asian-width": ["./vendor/get-east-asian-width/index.ts"],
			"diff": ["./vendor/diff/index.ts"],
			"minimatch": ["./vendor/minimatch/index.ts"],
			"brace-expansion": ["./vendor/brace-expansion/index.ts"],
			"semver": ["./vendor/semver/index.ts"],
			"lovely-mermaid": ["./vendor/lovely-mermaid/index.ts"],
			"partial-json": ["./vendor/partial-json/index.ts"]
		}
	},
	"include": ["packages/*/src/**/*"],
	"exclude": ["**/dist/**"]
}
