// Type-checks the example extensions against the modules extensions see at run time (core/extensions/virtual-modules.ts):
// "@pi-ts/ai" is the extension view, which adds TypeBox's Type, Static and TSchema to the compat entry (the
// view imports "@pi-ts/ai/compat", so that path stays the package's own).
// The other paths repeat the root tsconfig.json; keep them in sync.
// Also the test that imports the subagent example: it type-checks only against the extension view.
{
	"extends": "../../../tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@pi-ts/telemetry": [
				"../../../packages/telemetry/src/index.ts"
			],
			"@pi-ts/telemetry/testing": [
				"../../../packages/telemetry/src/testing/index.ts"
			],
			"@pi-ts/telemetry/render": [
				"../../../packages/telemetry/src/render.ts"
			],
			"@pi-ts/codemode": [
				"../../../packages/codemode/src/index.ts"
			],
			"@pi-ts/codemode/cloudflare": [
				"../../../packages/codemode/src/cloudflare.ts"
			],
			"@pi-ts/codemode/declarations": [
				"../../../packages/codemode/src/declarations.ts"
			],
			"@pi-ts/codemode/portable": [
				"../../../packages/codemode/src/portable.ts"
			],
			"@pi-ts/codemode/source": [
				"../../../packages/codemode/src/source.ts"
			],
			"@pi-ts/codemode/worker": [
				"../../../packages/codemode/src/runtime/worker.ts"
			],
			"@pi-ts/schema": [
				"../../../packages/schema/src/index.ts"
			],
			"@pi-ts/schema/formats": [
				"../../../packages/schema/src/formats/index.ts"
			],
			"@pi-ts/mcp": [
				"../../../packages/mcp/src/index.ts"
			],
			"@pi-ts/mcp/oauth": [
				"../../../packages/mcp/src/oauth/index.ts"
			],
			"@pi-ts/mcp/testing": [
				"../../../packages/mcp/src/testing/index.ts"
			],
			"@pi-ts/ai": [
				"../../../packages/coding-agent/src/core/extensions/pi-ai-extension-view.ts"
			],
			"@pi-ts/ai/oauth": [
				"../../../packages/ai/src/oauth.ts"
			],
			"@pi-ts/ai/*": [
				"../../../packages/ai/src/*.ts",
				"../../../packages/ai/src/providers/*.ts"
			],
			"@pi-ts/ai/dist/*": [
				"../../../packages/ai/src/*"
			],
			"@pi-ts/durable": [
				"../../../packages/durable/src/index.ts"
			],
			"@pi-ts/durable/testing": [
				"../../../packages/durable/src/testing/index.ts"
			],
			"@pi-ts/durable/*": [
				"../../../packages/durable/src/*.ts",
				"../../../packages/durable/src/*/index.ts",
				"../../../packages/durable/src/*"
			],
			"@pi-ts/env": [
				"../../../packages/env/src/index.ts"
			],
			"@pi-ts/agent-core": [
				"../../../packages/agent/src/index.ts"
			],
			"@pi-ts/coding-agent": [
				"../../../packages/coding-agent/src/index.ts"
			],
			"@pi-ts/coding-agent/hooks": [
				"../../../packages/coding-agent/src/core/hooks/index.ts"
			],
			"@pi-ts/coding-agent/*": [
