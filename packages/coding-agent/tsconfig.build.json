{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@pi-ts/agent-core": ["../agent/dist/index.d.ts"],
			"@pi-ts/agent-core/*": ["../agent/dist/*.d.ts"],
			"@pi-ts/ai": ["../ai/dist/index.d.ts"],
			"@pi-ts/ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@pi-ts/tui": ["../tui/dist/index.d.ts"],
			"@pi-ts/tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"],
			"@pi-ts/gui": ["../gui/dist/index.d.ts"],
			"@pi-ts/gui/native": ["../gui/dist/native.d.ts"],
			"@pi-ts/ffi": ["../ffi/src/index.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist", "src/experimental"]
}
